# ── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <your site>/api/auth/callback. Must be listed as an Authorized redirect URI.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Access ───────────────────────────────────────────────────
# The Google account(s) allowed to sign in (comma-separated). REQUIRED when deployed.
# Locally, if empty, the first account that signs in becomes the owner.
ALLOWED_EMAIL=
# Random string, 32+ characters. Signs your login cookie and encrypts your Gmail tokens.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=
# Random string. Required by the scheduled sync endpoint (/api/cron/sync).
CRON_SECRET=

# ── Database ─────────────────────────────────────────────────
# Postgres connection string (e.g. Neon). Leave empty locally to use the built-in embedded database in ./data.
DATABASE_URL=

# ── Classifier ───────────────────────────────────────────────
# Anthropic API key. Leave empty to use the built-in rules classifier.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5

# ── Sync ─────────────────────────────────────────────────────
# How far back the first sync looks (days), and the max emails processed per run.
SYNC_DAYS=120
MAX_EMAILS_PER_SYNC=150
